# Modèle de configuration de l'API Flowday.
#
#   1. Copiez ce fichier :   cp .env.example .env
#   2. Renseignez DATABASE_URL avec l'URI de votre base Supabase
#      (Supabase Dashboard → Project Settings → Database → Connection string → URI).
#      Le mot de passe doit rester URL-encodé (ex. @ → %40).
#   3. .env est ignoré par git : ces secrets ne partent jamais sur GitHub.
#
# Sans .env, Django refuse de démarrer avec le message « DATABASE_URL manquant ».
DATABASE_URL=postgresql://postgres.<PROJET>:<MOT_DE_PASSE_ENCODE>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
